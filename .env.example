# Copy this file to .env and fill in values. .env is gitignored.

# Required for live simulator access. Token is personal and is not stored in the repo.
SUPPLIER_SIM_MCP_URL=https://tools.scalepod.ai/supplier-sim/mcp
SUPPLIER_SIM_TOKEN=

# Required for run-dev extract. ping works without these.
# OPENROUTER_MODEL defaults to google/gemini-2.5-pro when unset.
# Runtime LLM spend is recorded in .artifacts/llm-spend.json against a $100 cap.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-pro

# Email bodies carry watermarks. Print with UTF-8.
PYTHONIOENCODING=utf-8
