# Copy this file to .env and fill in values. .env is gitignored.

# Required for live simulator access. Token is personal and is not stored in the repo.
SUPPLIER_SIM_MCP_URL=https://tools.scalepod.ai/supplier-sim/mcp
SUPPLIER_SIM_TOKEN=

# Optional. Runtime extract uses these; the first live round does not.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
